# Optional: NREL API key for PVWatts (SAM-style production data).
# Get a free key at https://developer.nrel.gov/signup/
# When set, you can enable "Use NREL PVWatts (SAM) API" in the app.
VITE_NREL_API_KEY=

# HubSpot — OFF by default. Set both lines to enable (see HUBSPOT.md).
HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=

# Server-side auth — bootstraps the first admin account into data/auth/users.json.
# Only used when no users exist yet; rotate your password via the app's Settings
# screen afterward instead of re-setting these. Never reuse a password that has
# ever appeared in committed source (e.g. the old CyanRyan05 seed — retired).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Session cookies. COOKIE_SECURE must be "true" once served over HTTPS.
# CORS_ORIGIN is only needed if the API is ever served from a different origin
# than the frontend (e.g. running server/index.mjs standalone) — leave blank
# for the normal same-origin deployment (npm start / npm run dev).
COOKIE_SECURE=false
CORS_ORIGIN=
